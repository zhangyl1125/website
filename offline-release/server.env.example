# Edit only on the target server. Keep the original values for existing data.
COMPOSE_PROJECT_NAME=app
POSTGRES_VOLUME=app_postgres_data
MINIO_VOLUME=app_minio_data
WEB_PORT=80
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
APP_CORS_ALLOWED_ORIGINS=https://cnaward.bosch-datanexus.com
# true for HTTPS; false for HTTP-only access through the bastion.
APP_AUTH_COOKIE_SECURE=true

# Enable only after the Entra registration, credentials and identity bindings are ready.
# Enter the secret only on the target server; never commit it or put it in VITE_*.
APP_SSO_ENABLED=false
APP_SSO_TENANT_ID=0ae51e19-07c8-4e4b-bb6d-648ee58410f4
APP_SSO_CLIENT_ID=bb6d57e7-a971-433f-882d-01d7ef3b0e49
APP_SSO_CLIENT_SECRET=
# HTTPS origin without a trailing slash; the SPA and API must share this origin.
APP_SSO_PUBLIC_BASE_URL=https://cnaward.bosch-datanexus.com
